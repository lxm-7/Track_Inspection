<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="24.11.1.0">
<procedure name="main">
<interface/>
<body>
<c>* 1. 读取文件</c>
<l>list_files ('P:/个人区/public/郑杰锋/接触网几何参数视频/车底轨道震动补偿/车底右相机轨道/9_8', ['files','follow_links'], FilesRight)</l>
<l>tuple_regexp_select (FilesRight, ['\\.(reg)$','ignore_case'], FilesRight)</l>
<c></c>
<l>list_files ('P:/个人区/public/郑杰锋/接触网几何参数视频/车底轨道震动补偿/车底左相机轨道/9_8', ['files','follow_links'], FilesLeft)</l>
<l>tuple_regexp_select (FilesLeft, ['\\.(reg)$','ignore_case'], FilesLeft)</l>
<c></c>
<l>tuple_sort (FilesRight, FilesRight)</l>
<l>tuple_sort (FilesLeft, FilesLeft)</l>
<c></c>
<c>* 2. 取最小长度</c>
<l>if (|FilesRight| &lt; |FilesLeft|)</l>
<l>    Num := |FilesRight|</l>
<l>else</l>
<l>    Num := |FilesLeft|</l>
<l>endif</l>
<c></c>
<l>dev_set_draw ('margin')</l>
<c></c>
<c>* 3. 循环处理Region</c>
<l>for i := 0 to Num - 1 by 1</l>
<c></c>
<l>    read_region (RegionRight, FilesRight[i])</l>
<l>    read_region (RegionLeft, FilesLeft[i])</l>
<c></c>
<c>    *--- 平移 ---</c>
<l>    move_region (RegionRight, RegionRightMoved, 0, 1000)</l>
<l>    move_region (RegionLeft, RegionLeftMoved, 0, -500)</l>
<c>    </c>
<c>    *------------------------------------</c>
<c>    * 找最低子区域（Right）</c>
<c>    *------------------------------------</c>
<l>    connection (RegionRightMoved, ConnR)</l>
<l>    smallest_rectangle1 (ConnR, Row1R, Col1R, Row2R, Col2R)</l>
<l>    tuple_max (Row2R, MaxRowR)</l>
<l>    tuple_find (Row2R, MaxRowR, IndexR)</l>
<l>    select_obj (ConnR, BottomRight, IndexR + 1)</l>
<c></c>
<c>    *------------------------------------</c>
<c>    * 找最低子区域（Left）</c>
<c>    *------------------------------------</c>
<l>    connection (RegionLeftMoved, ConnL)</l>
<l>    smallest_rectangle1 (ConnL, Row1L, Col1L, Row2L, Col2L)</l>
<l>    tuple_max (Row2L, MaxRowL)</l>
<l>    tuple_find (Row2L, MaxRowL, IndexL)</l>
<l>    select_obj (ConnL, BottomLeft, IndexL + 1)</l>
<c>    </c>
<c>    *------------------------------------</c>
<c>    * 极值点 + 连线</c>
<c>    *------------------------------------</c>
<l>    smallest_rectangle1 (BottomLeft, _, _, _, ColMaxL)</l>
<l>    smallest_rectangle1 (BottomRight, _, ColMinR, _, _)</l>
<c></c>
<l>    area_center (BottomLeft, _, RowL, _)</l>
<l>    area_center (BottomRight, _, RowR, _)</l>
<c></c>
<l>    gen_contour_polygon_xld (Line, [RowL, RowR], [ColMaxL, ColMinR])</l>
<c></c>
<c>    *------------------------------------</c>
<c>    * 中点</c>
<c>    *------------------------------------</c>
<l>    MidRow := (RowL + RowR) / 2</l>
<l>    MidCol := (ColMaxL + ColMinR) / 2</l>
<c></c>
<c>    *------------------------------------</c>
<c>    * 垂线（长度1000像素）</c>
<c>    *------------------------------------</c>
<l>    dRow := RowR - RowL</l>
<l>    dCol := ColMinR - ColMaxL</l>
<c></c>
<c>    * 垂直方向</c>
<l>    PerpRow := -dCol</l>
<l>    PerpCol := dRow</l>
<c></c>
<c>    * 归一化</c>
<l>    Length := sqrt(PerpRow*PerpRow + PerpCol*PerpCol)</l>
<l>    PerpRowN := PerpRow / Length</l>
<l>    PerpColN := PerpCol / Length</l>
<c></c>
<l>    HalfLen := 500</l>
<l>    RowP1 := MidRow - HalfLen * PerpRowN</l>
<l>    ColP1 := MidCol - HalfLen * PerpColN</l>
<l>    RowP2 := MidRow + HalfLen * PerpRowN</l>
<l>    ColP2 := MidCol + HalfLen * PerpColN</l>
<c></c>
<l>    gen_contour_polygon_xld (PerpLine, [RowP1, RowP2], [ColP1, ColP2])</l>
<c></c>
<c>    *------------------------------------</c>
<c>    * 坐标系（中心800,800）</c>
<c>    *------------------------------------</c>
<l>    AxisLen := 600</l>
<c>    </c>
<l>    AxisCenterRow := 650</l>
<l>    AxisCenterCol := 1100</l>
<c></c>
<c>    * X轴（水平线）</c>
<l>    gen_contour_polygon_xld (AxisX, [AxisCenterRow, AxisCenterRow], [AxisCenterCol-AxisLen, AxisCenterCol+AxisLen])</l>
<c>    </c>
<c>    * Y轴（竖直线）</c>
<l>    gen_contour_polygon_xld (AxisY, [AxisCenterRow-AxisLen, AxisCenterRow+AxisLen], [AxisCenterCol, AxisCenterCol])</l>
<c>    </c>
<c>    *------------------------------------</c>
<c>    * 显示</c>
<c>    *------------------------------------</c>
<l>    dev_clear_window ()</l>
<c></c>
<l>    dev_set_color ('red')</l>
<l>    dev_display (RegionRightMoved)</l>
<c></c>
<l>    dev_set_color ('green')</l>
<l>    dev_display (RegionLeftMoved)</l>
<c></c>
<l>    dev_set_color ('blue')</l>
<l>    dev_display (BottomRight)</l>
<c></c>
<l>    dev_set_color ('yellow')</l>
<l>    dev_display (BottomLeft)</l>
<c></c>
<l>    dev_set_color ('cyan')</l>
<l>    dev_display (Line)</l>
<c></c>
<l>    dev_set_color ('white')</l>
<l>    dev_display (PerpLine)</l>
<c></c>
<l>    dev_set_color ('white')</l>
<l>    dev_display (AxisX)</l>
<l>    dev_display (AxisY)</l>
<c></c>
<l>    wait_seconds (0.05)</l>
<c></c>
<l>endfor</l>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
</hdevelop>
