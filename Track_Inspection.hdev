<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="24.11.1.0">
<procedure name="main">
<interface/>
<body>
<c>* 1. 读取文件</c>
<l>list_files ('P:/个人区/public/郑杰锋/接触网几何参数视频/车底轨道震动补偿/车底右相机轨道/9_8', ['files','follow_links'], FilesRight)</l>
<l>tuple_regexp_select (FilesRight, ['\\.(reg)$','ignore_case'], FilesRight)</l>
<c></c>
<l>list_files ('P:/个人区/public/郑杰锋/接触网几何参数视频/车底轨道震动补偿/车底左相机轨道/9_8', ['files','follow_links'], FilesLeft)</l>
<l>tuple_regexp_select (FilesLeft, ['\\.(reg)$','ignore_case'], FilesLeft)</l>
<c></c>
<l>tuple_sort (FilesRight, FilesRight)</l>
<l>tuple_sort (FilesLeft, FilesLeft)</l>
<c></c>
<c>* 2. 长度</c>
<l>if (|FilesRight| &lt; |FilesLeft|)</l>
<l>    Num := |FilesRight|</l>
<l>else</l>
<l>    Num := |FilesLeft|</l>
<l>endif</l>
<c></c>
<l>dev_set_draw ('margin')</l>
<c></c>
<c>* 3. 循环</c>
<l>for i := 0 to Num - 1 by 1</l>
<c></c>
<l>    read_region (RegionRight, FilesRight[i])</l>
<l>    read_region (RegionLeft, FilesLeft[i])</l>
<c></c>
<c>    * 外接矩形</c>
<l>    smallest_rectangle2 (RegionRight, RowR, ColR, PhiR, L1R, L2R)</l>
<l>    smallest_rectangle2 (RegionLeft, RowL, ColL, PhiL, L1L, L2L)</l>
<c></c>
<c>    * 右长边方向</c>
<l>    if (L1R &gt;= L2R)</l>
<l>        PhiMain := PhiR</l>
<l>    else</l>
<l>        PhiMain := PhiR + rad(90)</l>
<l>    endif</l>
<c></c>
<c>    * 右移动 +1000</c>
<l>    dRowR := -1000 * sin(PhiMain)</l>
<l>    dColR := 1000 * cos(PhiMain)</l>
<l>    vector_angle_to_rigid (0, 0, 0, dRowR, dColR, 0, HomMatR)</l>
<l>    affine_trans_region (RegionRight, RegionRightMoved, HomMatR, 'nearest_neighbor')</l>
<c></c>
<c>    * 左移动 -500（反方向）</c>
<l>    dRowL := 500 * sin(PhiMain)</l>
<l>    dColL := -500 * cos(PhiMain)</l>
<l>    vector_angle_to_rigid (0, 0, 0, dRowL, dColL, 0, HomMatL)</l>
<l>    affine_trans_region (RegionLeft, RegionLeftMoved1, HomMatL, 'nearest_neighbor')</l>
<c></c>
<c>    * 重新计算中心（移动后）</c>
<l>    smallest_rectangle2 (RegionLeftMoved1, RowLM, ColLM, PhiLM, L1LM, L2LM)</l>
<c></c>
<c>    * 左右翻转（最终版）</c>
<l>    hom_mat2d_identity (HomMat2DIdentity)</l>
<l>    hom_mat2d_translate (HomMat2DIdentity, -RowLM, -ColLM, HomMatShift1)</l>
<l>    hom_mat2d_rotate (HomMatShift1, -PhiMain, 0, 0, HomMatRot1)</l>
<l>    hom_mat2d_scale (HomMatRot1, 1, -1, 0, 0, HomMatMirror)</l>
<l>    hom_mat2d_rotate (HomMatMirror, PhiMain, 0, 0, HomMatRot2)</l>
<l>    hom_mat2d_translate (HomMatRot2, RowLM, ColLM, HomMatFinal)</l>
<c></c>
<l>    affine_trans_region (RegionLeftMoved1, RegionLeftFinal, HomMatFinal, 'nearest_neighbor')</l>
<c></c>
<c>    * 显示</c>
<l>    dev_clear_window ()</l>
<l>    dev_set_color ('red')</l>
<l>    dev_display (RegionRightMoved)</l>
<l>    dev_set_color ('green')</l>
<l>    dev_display (RegionLeftFinal)</l>
<c></c>
<l>    wait_seconds (0.05)</l>
<c></c>
<l>endfor</l>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
</hdevelop>
