<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="24.11.1.0">
<procedure name="main">
<interface/>
<body>
<c>* 1. 读取文件</c>
<l>list_files ('P:/个人区/public/郑杰锋/接触网几何参数视频/车底轨道震动补偿/车底右相机轨道/9_8', ['files','follow_links'], FilesRight)</l>
<l>tuple_regexp_select (FilesRight, ['\\.(reg)$','ignore_case'], FilesRight)</l>
<c></c>
<l>list_files ('P:/个人区/public/郑杰锋/接触网几何参数视频/车底轨道震动补偿/车底左相机轨道/9_8', ['files','follow_links'], FilesLeft)</l>
<l>tuple_regexp_select (FilesLeft, ['\\.(reg)$','ignore_case'], FilesLeft)</l>
<c></c>
<l>tuple_sort (FilesRight, FilesRight)</l>
<l>tuple_sort (FilesLeft, FilesLeft)</l>
<c></c>
<c>* 2. 最小长度</c>
<l>if (|FilesRight| &lt; |FilesLeft|)</l>
<l>    Num := |FilesRight|</l>
<l>else</l>
<l>    Num := |FilesLeft|</l>
<l>endif</l>
<c></c>
<l>dev_set_draw ('margin')</l>
<c></c>
<c>* 3. 循环</c>
<l>for i := 0 to Num - 1 by 1</l>
<c></c>
<l>    read_region (RegionRight, FilesRight[i])</l>
<l>    read_region (RegionLeft, FilesLeft[i])</l>
<c></c>
<c>    * 最小外接矩形（只需要右侧决定方向）</c>
<l>    smallest_rectangle2 (RegionRight, RowR, ColR, PhiR, Length1R, Length2R)</l>
<c></c>
<c>    * 长边方向</c>
<l>    if (Length1R &gt;= Length2R)</l>
<l>        PhiMain := PhiR</l>
<l>    else</l>
<l>        PhiMain := PhiR + rad(90)</l>
<l>    endif</l>
<c></c>
<c>    * 平移距离</c>
<l>    Distance := 1000</l>
<c></c>
<c>    * 正方向（给左）</c>
<l>    dRow_Pos := -Distance * sin(PhiMain)</l>
<l>    dCol_Pos :=  Distance * cos(PhiMain)</l>
<c></c>
<c>    * 反方向（给右）</c>
<l>    dRow_Neg := -dRow_Pos/2</l>
<l>    dCol_Neg := -dCol_Pos/2</l>
<c></c>
<c>    * 构造变换</c>
<l>    vector_angle_to_rigid (0, 0, 0, dRow_Pos, dCol_Pos, 0, HomMat2D_Pos)</l>
<l>    vector_angle_to_rigid (0, 0, 0, dRow_Neg, dCol_Neg, 0, HomMat2D_Neg)</l>
<c></c>
<c>    * 平移</c>
<l>    affine_trans_region (RegionLeft, RegionLeftMoved, HomMat2D_Pos, 'nearest_neighbor')</l>
<l>    affine_trans_region (RegionRight, RegionRightMoved, HomMat2D_Neg, 'nearest_neighbor')</l>
<c></c>
<c>    * 显示</c>
<l>    dev_clear_window ()</l>
<l>    dev_set_color ('red')</l>
<l>    dev_display (RegionRightMoved)</l>
<l>    dev_set_color ('green')</l>
<l>    dev_display (RegionLeftMoved)</l>
<c></c>
<l>    wait_seconds (0.05)</l>
<c></c>
<l>endfor</l>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
</hdevelop>
